# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Find these in your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon / public)

# The REST URL of your Supabase project (Public, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The Anon / Public API Key (Public, safe for browser; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key-here

# Public site domain
NEXT_PUBLIC_SITE_URL=https://stgeorgeelectrical.com.au
