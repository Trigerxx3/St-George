# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Find these in your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys

# The REST URL of your Supabase project (Public, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon API Key (Public, safe for browser; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...your-publishable-key-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...your-publishable-key-here

# Public site domain
NEXT_PUBLIC_SITE_URL=https://stgeorgeelectrical.com.au
